{
  // Installer-only retirement list: factory agents deleted from the `agent`
  // block below. On upgrade the merger drops them from the preserved target
  // config and tiers.json — without this they would be misread as user-added
  // agents and preserved forever. Consumed by install/src/merger.ts and
  // stripped from the merged output; never reaches the opencode runtime.
  "removed_agents": ["coworker"],
  "adrMode": "flat",
  "$schema": "https://opencode.ai/config.json",
  "snapshot": true,
  "model": "llm-router/standard",
  "small_model": "llm-router/flash",
  "default_agent": "build",
  "permission": "allow",
  // L0 disclosure layer — injected into EVERY step of EVERY agent. Entries
  // MUST use absolute ~/ paths: opencode resolves relative instruction paths
  // against the current project directory (globUp from the working dir), not
  // the config dir — a relative entry would silently fail to load in any
  // project that lacks a matching instructions/*.md. Keep this array small,
  // static, and ordered (prefix-cache friendly). Role rules live at L1 (agent
  // prompt {file:} assembly below); scenario rules at L2 (skills/).
  "instructions": [
    "~/.config/opencode/instructions/rfc-keywords.md",
    "~/.config/opencode/instructions/output-protocol.md",
    "~/.config/opencode/instructions/verification-honesty.md",
    "~/.config/opencode/instructions/routing-index.md"
  ],
  // Default active external npm plugins. Optional plugins (opencode-qoder-bridge,
  // opencode-mem, etc.) are managed and enabled via install/options.jsonc.
  // Session titles use opencode's NATIVE title pipeline (built-in `title`
  // agent). `small_model` above defaults to the router's flash slot and is
  // overwritten by /profile apply with the active profile's flash tier, so
  // title generation and other host utility calls run on the cheapest
  // configured model — resolved with the host's own protocol/credential
  // handling. If the small-model call fails, opencode leaves the default
  // title; no plugin involved.
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  // Serena: LSP-based semantic code retrieval (symbol-level queries instead of
  // full file reads) — shared by all agents, avoids duplicate file reads.
  // CLI provisioning: the install script runs the `install` field automatically
  // when `serena` is missing from PATH (requires uv; then `uv tool update-shell`
  // once so ~/.local/bin is on PATH — see the opencode-prime install output).
  // Uses the `ide` context: basic file ops (read_file, list_dir, find_file,
  // create_text_file) and the shell are excluded — those stay with the agents'
  // native tools. Serena's symbolic EDITING/refactoring tools remain exposed;
  // to make it strictly read-only, exclude them per project in
  // .serena/project.yml (`excluded_tools`). `--project-from-cwd` activates the project
  // at the current working directory (.serena/project.yml or .git detected).
  // `--open-web-dashboard False`: the dashboard still runs in the background
  // (tray icon / http://localhost:24282/dashboard/) but no UI window pops up
  // per session — without this, every opencode conversation opens one.
  // If serena is not installed, set "enabled": false — agents fall back to
  // grep/glob/file reads per their prompts.
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "import(require('url').pathToFileURL(require('path').join(require('os').homedir(), '.config/opencode/scripts/serena-workspace-daemon.mjs')).href)"
      ],
      "install": "uv tool install -p 3.13 serena-agent@latest --prerelease=allow",
      "enabled": true
    },
    // CodeGraph (default graph backend): pre-indexed code knowledge graph
    // (Tree-sitter → SQLite). Complements Serena: adds structural macro
    // queries — "how does X work" / flows, impact/blast radius, dependency
    // chains, area surveys, framework-aware
    // routes. MIT licensed. Fixed tool surface: a single `codegraph_explore`.
    // Index lifecycle: ONE-TIME manual `codegraph init` per repo (MCP does NOT
    // auto-build a missing index); after that a built-in file watcher keeps it
    // in sync on every save + reconciliation on reconnect — never stale.
    // CLI provisioning: the install script runs the `install` field
    // automatically when `codegraph` is missing (requires npm).
    // "enabled": false to skip.
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "install": "npm install -g @colbymchenry/codegraph",
      "enabled": true
    },
    // GitNexus (optional): deeper graph analysis — arbitrary Cypher, Web UI
    // visualization, precomputed processes/clusters, multi-repo groups.
    // NOTE: PolyForm Noncommercial license — commercial use needs licensing.
    // Requires manual re-index (`gitnexus analyze`) after big changes.
    // One MCP server serves every indexed repo (registry ~/.gitnexus/).
    // GITNEXUS_MCP_READ_ONLY=1: read-only graph tools only — edits stay with
    // the agents' native tools. "enabled": true only if licensed + indexed.
    // `install` is pre-declared but dormant: while "enabled" stays false the
    // install script skips it; flipping enabled to true makes the next install
    // provision the CLI automatically (licensing + per-repo `gitnexus analyze`
    // remain your decision).
    "gitnexus": {
      "type": "local",
      "command": ["gitnexus", "mcp"],
      "install": "npm install -g gitnexus",
      "env": { "GITNEXUS_MCP_READ_ONLY": "1" },
      "enabled": false
    },
    // DBHub (optional): universal database gateway — PostgreSQL, MySQL,
    // MariaDB, SQL Server, SQLite through one server. Token-efficient:
    // 2 tools by default (~1.4k tokens). Bytebase project, MIT licensed.
    // Requires Node >= 22.5. Configuration is PER-PROJECT, not shipped:
    // dbhub auto-discovers ./dbhub.toml from the working directory (or
    // --config / DSN env var). TOML values support ${ENV_VAR} interpolation
    // — keep credentials out of any repo. Read-only is enforced per tool
    // in the TOML ([[tools]] readonly = true); the old --readonly flag is
    // removed upstream. Enabled by default in install/options.jsonc, so
    // installs provision the CLI and flip `enabled` — the false below is
    // only the shipped template fallback (direct copies without the
    // installer). dbhub.toml + DSN in each project remain your setup.
    // Example dbhub.toml in the project root:
    //   [[sources]]
    //   id = "default"
    //   dsn = "${DBHUB_DSN}"
    //   [[tools]]
    //   name = "execute_sql"
    //   source = "default"
    //   readonly = true
    "dbhub": {
      "type": "local",
      "command": ["dbhub", "--transport", "stdio", "--config", "./dbhub.toml"],
      "install": "npm install -g @bytebase/dbhub",
      "enabled": false
    },
    // Headroom (optional): local context compression — compresses tool outputs,
    // logs, and RAG chunks before they reach the LLM; originals stay
    // retrievable on demand via CCR (`headroom_retrieve`). Apache 2.0,
    // local-first. Complements rtk/ponytail, which cover the OUTPUT side —
    // headroom targets the INPUT side. MCP mode is agent-driven (compress on
    // demand); the fully automatic `headroom proxy` mode is NOT wired in here
    // because it rewrites provider base URLs. Heavy provisioning: uv tool
    // with Python 3.13, and the first run downloads the ONNX runtime
    // (cdn.pyke.io) + Kompress compression model (huggingface.co). Flip
    // "enabled" to true only if you accept those downloads.
    "headroom": {
      "type": "local",
      "command": ["headroom", "mcp", "serve"],
      "install": "uv tool install --python 3.13 \"headroom-ai[all]\"",
      "enabled": false
    },
    // JetBrains IDE MCP bridge — remote server exposed by the running IDE
    // (IntelliJ / WebStorm / etc.) on the local stream endpoint. No CLI to
    // install; the IDE must be running with its MCP server enabled.
    //
    // IDE-side setup (one-time per project):
    //   1. Install the "MCP Server" plugin (JetBrains Marketplace) if not
    //      already bundled by your IDE version.
    //   2. Open: Settings (Preferences) → Tools → MCP Server.
    //   3. Toggle the server ON and apply. The IDE starts listening on
    //      127.0.0.1:64342/stream — verify the port matches.
    //   4. Keep the IDE running; this endpoint dies when the IDE closes.
    //
    // Then flip "enabled" here (or via install/options.jsonc) to connect.
    "idea": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/stream",
      "enabled": false
    }
  },
  // L1 disclosure layer: each agent prompt = its own agents/*.md plus the
  // rule files its role actually needs, assembled via {file:} markers (order
  // fixed: agent md first, then rules). Routing matrix:
  //   coding pack (coding-principles + comment-strategy + edit-protocol +
  //   test-scope): code, fast-coder, the six language devs, devops, qa
  //   coding pack + sql-migration: dba
  //   coding-principles + comment-strategy + test-scope: code-review (edit denied)
  //   coding-principles only (review criteria): architect, advisor, security
  //   zero additions: build, plan, explorer, researcher, tech-writer, vision
  //
  // Block field order (convention): description, prompt, then tuning
  // metadata (mode/model/temperature/steps/variant), permission/tools last.
  //
  // Per-step visibility & tool-face policy lives HERE, on the agent blocks
  // below, as native opencode `permission`/`tools` fields. Semantics
  // (opencode v1.18.25, verified against permission/index.ts):
  // `"<prefix>*": { "*": "deny" }` hides MCP tools AND the server's
  // <mcp_instructions> block; skill "*" deny empties the skills block;
  // tools <name>:false removes a native tool schema entirely (permission
  // denies on native tools save zero tokens). Protocol-injector gating (an
  // opencode gap) lives in plugin-scope.json (repo root), enforced at
  // runtime by plugins/shared/plugin-scope.ts. Quantify any change with
  // scripts/measure-prompts.ts before releasing.
  //
  // L2 layer: `lite` is an overhead-free primary — inline prompt, no skills,
  // no MCP, OCP injectors skip it via plugin-scope.json, plugins/lite-mode.ts strips
  // L0 instructions (keeping the `<!-- lite-mode -->` sentinel), and
  // plugins/lite-tools.ts compresses native tool descriptions (measured:
  // stock ≈ 8.4k → ≈ 1.7k tok/step).
  "agent": {
    "lite": {
      "description": "Lite — minimal-overhead primary for everyday use: lookups, web research, chat, quick tasks. No rule files, no skills, no MCP, no L0 instructions (the lite-mode plugin strips them). Suggest @build for heavy multi-domain coding work.",
      "prompt": "<!-- lite-mode -->\nYou are lite, a minimal-overhead assistant. Answer directly and concisely. Use websearch/webfetch for lookups. Suggest @build for heavy multi-domain coding work.",
      "mode": "primary",
      "model": "llm-router/flash",
      "temperature": 0.3,
      "variant": "low",
      // Only denies that actually shrink the prompt: skill "*" empties the resident skills block; each MCP prefix deny removes tool definitions plus <mcp_instructions> (serena/codegraph ~10.9k tok/step); the plugin-tool schemas lite never needs. tools:false entries drop heavy native schemas.
      "permission": {
        "skill": { "*": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "dbhub_*": { "*": "deny" },
        "idea_*": { "*": "deny" },
        "md_to_pdf": { "*": "deny" },
        "md_to_docx": { "*": "deny" },
        "browser_screenshot": { "*": "deny" }
      },
      "tools": {
        "skill": false,
        "lsp": false,
        "todoread": false,
        "todowrite": false,
        "apply_patch": false,
        "question": false,
        "task": false
      }
    },
    "build": {
      "description": "Build — default entry point for all tasks. Routes every coding task to the right specialist agent (even simple ones); handles only non-coding tasks (exploration, Q&A, git info) directly. Coordinates multi-step workflows across agents.",
      "prompt": "{file:~/.config/opencode/agents/build.md}",
      "mode": "primary",
      "model": "llm-router/standard",
      "temperature": 0.3,
      "variant": "medium",
      // Build routes work, it doesn't do it — hide the MCP tool surface (~10.9k tok/step). sdd-workflow stays: /prd /sdd land here.
      "permission": { "serena_*": { "*": "deny" }, "codegraph_*": { "*": "deny" } }
    },
    "plan": {
      "description": "Plan orchestrator — coordinator that dispatches analysis tasks to specialists, persists structured plan artifacts (docs/plan/<topic>.md), and provides clean execution handoffs.",
      "prompt": "{file:~/.config/opencode/agents/plan.md}",
      "mode": "primary",
      "model": "llm-router/standard",
      "temperature": 0.3,
      "variant": "medium",
      // Plan dispatches analysis to specialists — no direct code-intel calls. SDD stays: /prd /adr /plan /impl run from here.
      "permission": { "serena_*": { "*": "deny" }, "codegraph_*": { "*": "deny" } }
    },
    "code": {
      "description": "Code — direct developer. Primary agent that does the coding work itself: implement, fix, refactor, test. Never proactively delegates; manual delegation allowed only for assists (advisor, explorer, code-review, vision). For single-domain tasks; suggests @build when multi-domain.",
      "prompt": "{file:~/.config/opencode/agents/code.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "primary",
      "model": "llm-router/pro",
      "temperature": 0.3,
      "variant": "medium"
    },
    "advisor": {
      "description": "Decision advisor — provides independent second-opinion analysis on blocking decisions. Invoke when the orchestrator needs a second perspective before presenting a blocking decision to the user.",
      "prompt": "{file:~/.config/opencode/agents/advisor.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "model": "llm-router/max",
      "temperature": 0.3,
      "steps": 25,
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "ask",
        "websearch": "ask",
        "skill": { "sdd-workflow": "deny" }
      }
    },
    "explorer": {
      "description": "Fast read-only codebase explorer. Use for architecture overviews, intent & design questions, and pattern discovery. Structural lookups (definitions, references, symbol outlines) go to Serena MCP tools; multi-hop call paths and impact analysis go to CodeGraph instead.",
      "prompt": "{file:~/.config/opencode/agents/explorer.md}",
      "mode": "subagent",
      "model": "llm-router/flash",
      "temperature": 0.2,
      "steps": 40,
      "variant": "low",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": { "sdd-workflow": "deny" }
      }
    },
    "researcher": {
      "description": "Tech researcher — evaluates technologies, compares alternatives, produces feasibility studies and trade-off reports. Invoke for research, compare, evaluate, benchmark, or 'which should we use?' questions.",
      "prompt": "{file:~/.config/opencode/agents/researcher.md}",
      "mode": "subagent",
      "model": "llm-router/standard",
      "temperature": 0.3,
      "variant": "medium",
      // Web/tech research runs outside the codebase — hide the MCP tool surface. bash stays: benchmarks and trial CLIs are core research work.
      "permission": {
        "edit": "deny",
        "skill": { "sdd-workflow": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" }
      }
    },
    "architect": {
      "description": "Tech lead / software architect — system design, ADRs, task decomposition, trade-off analysis, API contract design. Invoke for architecture, system design, task breakdown, or 'how should we design this?'",
      "prompt": "{file:~/.config/opencode/agents/architect.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "model": "llm-router/max",
      "temperature": 0.4,
      "variant": "high",
      "permission": { "edit": "deny" }
    },
    "dba": {
      "description": "Database architect — schema design, SQL optimization, index strategy, query analysis, migration planning, sharding/partitioning. Invoke for database, SQL, schema, migration, index, or query optimization.",
      "prompt": "{file:~/.config/opencode/agents/dba.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}\n\n{file:~/.config/opencode/instructions/sql-migration.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.2,
      "variant": "medium",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    },
    "security": {
      "description": "Security engineer — vulnerability assessment, security architecture review, OWASP analysis, dependency scanning, compliance. Invoke for security, vulnerability, OWASP, encryption, or 'is this secure?'",
      "prompt": "{file:~/.config/opencode/agents/security.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "model": "llm-router/max",
      "temperature": 0.2,
      "variant": "high",
      "permission": { "edit": "deny", "skill": { "sdd-workflow": "deny" } }
    },
    "java-dev": {
      "description": "Java/Spring Boot engineer — Java, Spring Boot, Spring Security, JPA/Hibernate, Maven/Gradle, JUnit. Invoke for Java, Spring, JPA, Hibernate, Maven, Gradle, or JVM tasks.",
      "prompt": "{file:~/.config/opencode/agents/java-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.3,
      "variant": "medium",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    },
    "python-dev": {
      "description": "Python engineer — FastAPI, Django, Flask, async Python, pandas/numpy, scripting, pytest. Invoke for Python, FastAPI, Django, Flask, pandas, numpy, or pip tasks.",
      "prompt": "{file:~/.config/opencode/agents/python-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.3,
      "variant": "medium",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    },
    "go-dev": {
      "description": "Go engineer — Gin, Echo, Fiber, gRPC, protobuf, Cobra, microservices, goroutines. Invoke for Go, Golang, Gin, gRPC, protobuf, or Cobra tasks.",
      "prompt": "{file:~/.config/opencode/agents/go-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.3,
      "variant": "medium",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    },
    "rust-dev": {
      "description": "Rust engineer — Cargo, Axum, Actix, Tokio, serde, WASM, systems programming. Invoke for Rust, Cargo, Tokio, Axum, Actix, serde, or wasm tasks.",
      "prompt": "{file:~/.config/opencode/agents/rust-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.3,
      "variant": "medium",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    },
    "node-dev": {
      "description": "Node.js/TypeScript engineer — NestJS, Express, Fastify, Prisma, TypeORM, npm/pnpm. Invoke for Node.js, NestJS, Express, Fastify, Prisma, TypeORM, or npm/pnpm tasks.",
      "prompt": "{file:~/.config/opencode/agents/node-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.3,
      "variant": "medium",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    },
    "frontend-dev": {
      "description": "Frontend engineer — React/Vue/Svelte/Next.js, TypeScript, CSS/Tailwind, accessibility, performance. Invoke for frontend, React, Vue, Svelte, CSS, Tailwind, UI, or component work.",
      "prompt": "{file:~/.config/opencode/agents/frontend-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.3,
      "variant": "medium",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    },
    "qa": {
      "description": "QA engineer — test planning, test generation, coverage analysis, E2E strategy, quality gates. Invoke for testing, QA, coverage, E2E, integration tests, or regression.",
      "prompt": "{file:~/.config/opencode/agents/qa.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.3,
      "variant": "medium",
      "permission": { "webfetch": "ask", "skill": { "sdd-workflow": "deny" } }
    },
    "code-review": {
      "description": "Code reviewer — reviews git diffs, PRs, staged/unstaged changes, specific files. Invoke for code review, PR review, or feedback on code quality, correctness, security, or best practices.",
      "prompt": "{file:~/.config/opencode/agents/code-review.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/max",
      "temperature": 0.3,
      "variant": "high",
      "permission": {
        "edit": "deny",
        "webfetch": "ask",
        "websearch": "ask",
        "skill": { "sdd-workflow": "deny" }
      }
    },
    "devops": {
      "description": "DevOps/SRE engineer — Docker, Kubernetes, CI/CD, Terraform, monitoring, deployment. Invoke for Docker, K8s, deploy, CI/CD, pipeline, Terraform, or infrastructure.",
      "prompt": "{file:~/.config/opencode/agents/devops.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/pro",
      "temperature": 0.2,
      "variant": "medium",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    },
    "tech-writer": {
      "description": "Technical writer — README, API docs, architecture docs, ADRs, changelogs, user guides. Invoke for documentation, README, changelog, ADR, or developer guide tasks.",
      "prompt": "{file:~/.config/opencode/agents/tech-writer.md}",
      "mode": "subagent",
      "model": "llm-router/standard",
      "temperature": 0.3,
      "variant": "medium",
      // Docs work reads rendered text, not symbol graphs — hide the MCP tool surface.
      "permission": {
        "skill": { "sdd-workflow": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" }
      }
    },
    "vision": {
      "description": "Visual / vision analyst — screenshot analysis, UI critique, OCR, diagram interpretation. Invoke for image, screenshot, OCR, or visual analysis tasks.",
      "prompt": "{file:~/.config/opencode/agents/vision.md}",
      "mode": "subagent",
      "model": "llm-router/vision",
      "temperature": 0.2,
      "steps": 30,
      "variant": "medium",
      // Image analysis has no use for code graphs — hide the MCP tool surface.
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "ask",
        "websearch": "ask",
        "skill": { "sdd-workflow": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" }
      }
    },
    "fast-coder": {
      "description": "Flash Coder — agile, high-throughput full-stack coding subagent powered by Flash/Lite model tiers. Dispatched for rapid coding and iterative review loops.",
      "prompt": "{file:~/.config/opencode/agents/fast-coder.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "model": "llm-router/flash",
      "temperature": 0.2,
      "variant": "low",
      "permission": { "skill": { "sdd-workflow": "deny" } }
    }
  }
}
