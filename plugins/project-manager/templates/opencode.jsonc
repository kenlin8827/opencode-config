{
  "$schema": "https://opencode.ai/config.json",
  // Project-level OpenCode configuration — generated by /project init.
  // Docs: https://opencode.ai/docs/config/
  //
  // Plugin switches — project-level; unset fields use the built-in default
  // (off). Every line below is ready-to-use JSONC: just remove the leading
  // // (the comma is already there) to enable for THIS project only.
  //
  // "autoAdvisorMode": "lite",  // off | lite | full — /auto-advisor <mode>
  // "adrGuard": "on",           // on | off          — /adr-guard <state>
  // "adrGuardDir": "docs/adr",  // ADR directory
  // "envGuard": "on",           // on | off — blocks agent access to secret .env* files (.env.example exempt)
}
