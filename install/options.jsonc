// Install options — single source of truth for which MCP servers, external
// (npm) plugins, and the rtk proxy this config activates. Replaces the old
// -EnableMcp/--enable-mcp command-line flags.
//
// Lives in install/ with the other installer machinery (VERSION, manifests):
// every install reads it in place and forces the target state onto it — it
// overwrites unconditionally on EVERY install and never ships to the target.
// Edit THIS file and re-run the installer (`install -Force` when the version
// is unchanged):
//   mcp.<name>     → opencode.jsonc's mcp.<name>.enabled; enabling an entry
//                    that declares an `install` field also provisions its CLI
//                    on the next install
//   plugin.<name>  → membership in opencode.jsonc's `plugin` array
//   default_agent  → opencode.jsonc's root `default_agent` — which primary
//                    agent (build / code / plan) opencode enters first;
//                    must name an agent that exists in the shipped `agent`
//                    block (unknown names are rejected, template value kept)
//                    Options: build / code / coworker / plan
//   rtk            → rtk binary provisioning + the vendored openrtk plugin
//                    (false skips the download AND removes plugins/openrtk*
//                    from the target)
//   openchamber    → OpenChamber web UI CLI provisioning; true installs the
//                    `openchamber` CLI globally when missing (powers
//                    `ocp web`; the native desktop app behind `ocp desktop` /
//                    `ocp ui` is a separate download), false skips it
//
// Your choices persist in this file (git). No copy is installed under
// ~/.config/opencode — the switches apply straight onto opencode.jsonc
// (mcp.*.enabled + the plugin array), so nothing in the target looks like
// an editable options file. Entries this file doesn't list keep the shipped
// template value (opencode.template.jsonc). Bundled plugins/*.ts files are
// NOT options — they ship wholesale and are always active.
//
// global_commands → register global CLI shims (ocp / opencode-prime)
// into ~/.local/bin and append that directory to the
// user's PATH environment variable. Set false to skip; the standalone
// `register` / `unregister` actions remain available regardless.
{
  "global_commands": true,
  // true = install/update the OpenChamber web UI CLI (`openchamber`,
  // https://openchamber.dev) via the global package manager when missing —
  // it powers `ocp web`; the native desktop app behind `ocp desktop` /
  // `ocp ui` is a separate download. Requires Node.js 22+. false = skip
  // provisioning (an already-installed `openchamber` binary stays put).
  "openchamber": true,
  // true = provision the rtk binary + keep the vendored openrtk plugin;
  // false = skip the download and remove plugins/openrtk.ts + plugins/openrtk/
  // from the target (an already-installed rtk binary on PATH stays put)
  "rtk": true,
  // Which primary agent opencode enters by default:
  //   code     — direct developer; does the coding work itself (daily driver)
  //   coworker — collaborative pair-programmer; frames tasks as real customer
  //              requirements with a "we're in this together" dynamic
  //   build    — orchestrator; routes coding tasks to specialists
  //   plan     — read-only coordinator for analysis / design work
  // Unknown names are rejected with a warning (template value kept).
  "default_agent": "code",
  // true = enabled (CLI auto-provisioned via `install` if missing); false = skipped
  "mcp": {
    // LSP semantic code retrieval/editing; needs uv
    "serena": false,
    // Code-graph exploration; needs one-time manual `codegraph init` per repo
    "codegraph": true,
    // PolyForm Noncommercial license — enable only if licensed + indexed
    // (see the gitnexus comment in opencode.template.jsonc)
    "gitnexus": false,
    // Universal DB gateway (MIT, ~1.4k tokens); CLI auto-provisioned.
    // Still needs per-project dbhub.toml + DSN (see opencode.template.jsonc) —
    // without one, dbhub just fails to connect at session start
    "dbhub": true,
    // JetBrains IDE MCP bridge — remote server exposed by the running IDE
    // (IntelliJ / WebStorm / etc.) on 127.0.0.1:64342. No CLI to install;
    // enable the MCP server in the IDE first (Settings → Tools → MCP Server),
    // then flip this switch to connect.
    "idea": true
  },
  // true = in opencode.jsonc's `plugin` array; false = dropped
  "plugin": {
    // Lazy coding protocol: build what was asked, name the lazier alternative
    "@dietrichgebert/ponytail": true,
    // Injects qoder provider/models; needs Node ^22.18 || >=24.11 + `qoder login`
    "opencode-qoder-bridge": false,
    // Persistent project memory (vector store, per-machine under ~/.opencode-mem/);
    // heavy — auto-capture costs an LLM call per idle session (see its docs)
    "opencode-mem@2.24.3": false
  }
}